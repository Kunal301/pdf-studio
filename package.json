    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
